# Copy to roadscanner.env only for manual Docker/Compose use.
# The advanced installer generates a protected roadscanner.env automatically.
# Never commit real values.

INVITE_CODE_SECRET_KEY=replace-with-a-long-random-secret
ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
admin_username=admin
admin_pass=replace-with-a-strong-random-password

STRICT_PQ2_ONLY=1
QRS_BOOTSTRAP_SHOW=0
QRS_ROTATE_SESSION_KEY=1
QRS_SESSION_KEY_ROTATION_PERIOD_SECONDS=1800

# Optional providers:
# OPENAI_API_KEY=
# GROK_API_KEY=
# GEMINI_API_KEY=

# Optional app URLs:
# PUBLIC_BASE_URL=https://example.com
