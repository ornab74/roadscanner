# V0.6: migrate the separate registry with 0004 and sign in again before issuing device tokens.
# TEMPLATE ONLY. Use runtime secrets, never a committed plaintext secrets file.
ROADSCANNER_CX_ENABLED=0
ROADSCANNER_CX_REGISTRY_ENABLED=0
# Choose one backend only after explicitly initializing its NEW schema:
# ROADSCANNER_CX_REGISTRY_BACKEND=d1
# CLOUDFLARE_ACCOUNT_ID=<account identifier>
# ROADSCANNER_CX_D1_ID=<new registry D1 UUID>
# ROADSCANNER_CX_D1_TOKEN=<least-privilege server-only API token>
# Alternative for local staging only (NOT ephemeral Cloudflare disk):
# ROADSCANNER_CX_REGISTRY_BACKEND=sqlite
# ROADSCANNER_CX_REGISTRY_PATH=/absolute/new/registry.db
# ROADSCANNER_CX_OWNER_KEY=<stable, separate 32+ character random secret; BACK UP>
# PINATA_JWT=<server-only pinning secret>
ROADSCANNER_CX_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
ROADSCANNER_CX_DEVICE_AI_ENABLED=0
# ROADSCANNER_CX_AI_MODEL=<supported Chat Completions JSON model>
# OPENAI_API_KEY=<server-only secret>
# Retire shared bearer relay after device migration; not enabled by default:
ROADSCANNER_CX_ALLOW_LEGACY_RELAY=0
# Original admin/native key/persistence environment is still required.
